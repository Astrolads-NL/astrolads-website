---

<LayoutNight
  title="Agenda"
  description="Aankomende events van de Astrolads Community in Den Haag."
  image="/images/og/community/community.jpg"
>
  <div class="agenda-page">
    <div class="section-inner">
      <Breadcrumb 
        theme="dark"
        items={[
          { name: 'Community', url: '/community' },
          { name: 'Agenda' }
        ]} 
      />

      <header class="agenda-header">
        <p class="eyebrow">Astrolads Community</p>
        <h1>Agenda</h1>
        <p class="lead">Ontdek talenten, ontmoet andere creatieve jongeren en doe mee aan onze events in de Astrolads Studio aan de Grote Markt.</p>
      </header>

      <div class="filters">
        <button class="filter-btn active" data-filter="all">Alle</button>
        <button class="filter-btn" data-filter="pixels-pawns">Pixels & Pawns</button>
        <button class="filter-btn" data-filter="try-out">Try-out Club</button>
        <button class="filter-btn" data-filter="masterclass">Masterclass</button>
        <button class="filter-btn" data-filter="meetup">Meetup</button>
      </div>

      <div class="timeline">
        {events.map((e, i) => (
          <div class:list={['timeline-item', i % 2 === 0 ? 'left' : 'right']} data-type={e.type}>
            <div class="timeline-dot" aria-hidden="true"></div>
            <div class="timeline-date" aria-hidden="true">
              <span class="td-maand">{e.maand}</span>
              <span class="td-dag">{e.dag}</span>
              <span class="td-dagnaam">{e.dagNaam}</span>
            </div>
            <article class="event-card">
              <div class="event-banner" style={`background-image: url(${e.foto});`}>
                <div class="badges-top">
                  <span class={`type-badge type-${e.type}`}>{e.typeLabel}</span>
                  {e.collab && <span class="collab-badge">i.s.m. {e.collab}</span>}
                </div>
                <div class="prijs-badge">{e.prijs}</div>
              </div>
              <div class="event-body">
                <h3>{e.titel}</h3>
                <div class="event-meta">
                  <span>🕐 {e.tijd}</span>
                  <span>📍 {e.locatie}</span>
                  {e.vol ? (
                    <span class="meta-vol">✗ Vol</span>
                  ) : (
                    <span>👥 {e.plekkenOver} plekken</span>
                  )}
                </div>
                <p class="event-beschrijving">{e.beschrijving}</p>
                                {e.vol ? (
                  <button class="aanmeld-btn aanmeld-btn-secondary" data-form-modal={e.slug} data-form-titel={e.titel}>Wachtlijst →</button>
                ) : (
                  <button class="aanmeld-btn" data-form-modal={e.slug} data-form-titel={e.titel}>Aanmelden →</button>
                )}
              </div>
            </article>
          </div>
        ))}
      </div>

           <div class="member-cta">
        <div class="member-cta-text">
          <p class="member-eyebrow">Nieuwsbrief</p>
          <h3>Blijf op de hoogte</h3>
          <p>Blijf op de hoogte van onze nieuwste evenementen, give-aways, workshops en meer!</p>
        </div>
        <form
          class="member-form"
          name="nieuwsbrief"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          id="nieuwsbrief-form"
        >
          <input type="hidden" name="form-name" value="nieuwsbrief" />
          <p class="hidden-honey"><label>Niet invullen: <input name="bot-field" /></label></p>

          <div class="form-row">
            <div class="form-field">
              <label for="nb-voornaam">Voornaam</label>
              <input type="text" id="nb-voornaam" name="voornaam" required autocomplete="given-name" />
            </div>
            <div class="form-field">
              <label for="nb-achternaam">Achternaam</label>
              <input type="text" id="nb-achternaam" name="achternaam" required autocomplete="family-name" />
            </div>
          </div>

          <div class="form-field">
            <label for="nb-geboortedatum">Geboortedatum</label>
            <input type="date" id="nb-geboortedatum" name="geboortedatum" required />
          </div>

          <div class="form-field">
            <label for="nb-email">E-mailadres</label>
            <input type="email" id="nb-email" name="email" required autocomplete="email" />
          </div>

          <button type="submit" class="member-submit">Aanmelden →</button>
        </form>

        <div id="nieuwsbrief-success" class="nieuwsbrief-success" hidden>
          <div class="form-success-icon">✓</div>
          <h3>Bedankt!</h3>
          <p>Je staat op de lijst. We houden je op de hoogte.</p>
        </div>
      </div>
      </div>

    </div>
  </div>
<!-- Hidden Netlify form definities (1 per event) -->
<div hidden aria-hidden="true">
  {events.map(e => (
    <form name={`event-${e.slug}`} data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value={`event-${e.slug}`} />
      <input type="hidden" name="event-titel" />
      <input type="text" name="voornaam" />
      <input type="text" name="achternaam" />
      <input type="date" name="geboortedatum" />
           <input type="email" name="email" />
      <input type="checkbox" name="nieuwsbrief" />
      <input type="text" name="bot-field" />
    </form>
  ))}
</div>

<!-- Aanmeldformulier modal -->
<div id="form-modal" class="form-modal" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="form-modal-backdrop" data-form-close></div>
  <div class="form-modal-content">
    <div class="form-modal-header">
      <div>
        <p class="form-modal-eyebrow">Aanmelden</p>
        <h3 class="form-modal-titel" id="form-modal-titel"></h3>
      </div>
      <button class="form-modal-close" data-form-close aria-label="Sluiten">×</button>
    </div>

    <div class="form-modal-body">
      <form id="event-aanmeld-form" class="event-aanmeld-form" method="POST">
        <input type="hidden" name="form-name" id="form-name-input" />
        <input type="hidden" name="event-titel" id="event-titel-input" />
        <p hidden><label>Niet invullen: <input name="bot-field" /></label></p>

        <div class="form-row">
          <label>
            Voornaam
            <input type="text" name="voornaam" required autocomplete="given-name" />
          </label>
          <label>
            Achternaam
            <input type="text" name="achternaam" required autocomplete="family-name" />
          </label>
        </div>

        <label>
          Geboortedatum
          <input type="date" name="geboortedatum" required />
        </label>

                <label>
          E-mail
          <input type="email" name="email" required autocomplete="email" />
        </label>

        <label class="checkbox-label">
          <input type="checkbox" name="nieuwsbrief" value="ja" />
          <span>Ik wil op de hoogte worden gehouden van evenementen, give-aways en workshops.</span>
        </label>

        <button type="submit" class="form-submit-btn">Aanmelden →</button>
      </form>

      <div id="form-success" class="form-success" hidden>
        <div class="form-success-icon">✓</div>
        <h3>Bedankt!</h3>
        <p>Je aanmelding is ontvangen. We nemen contact op als er updates zijn.</p>
        <button type="button" class="form-submit-btn" data-form-close>Sluiten</button>
      </div>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('form-modal');
  const form = document.getElementById('event-aanmeld-form');
  const success = document.getElementById('form-success');
  const titelEl = document.getElementById('form-modal-titel');
  const formNameInput = document.getElementById('form-name-input');
  const eventTitelInput = document.getElementById('event-titel-input');

  function openModal(slug, titel) {
    formNameInput.value = 'event-' + slug;
    eventTitelInput.value = titel;
    titelEl.textContent = titel;
    form.reset();
    formNameInput.value = 'event-' + slug;
    eventTitelInput.value = titel;
    form.hidden = false;
    success.hidden = true;
    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('[data-form-modal]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      openModal(btn.getAttribute('data-form-modal'), btn.getAttribute('data-form-titel'));
    });
  });

  document.querySelectorAll('[data-form-close]').forEach(function(btn) {
    btn.addEventListener('click', closeModal);
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal.classList.contains('open')) closeModal();
  });

  form.addEventListener('submit', async function(e) {
    e.preventDefault();
    const submitBtn = form.querySelector('.form-submit-btn');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Bezig...';

    try {
      const formData = new FormData(form);
      await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(formData).toString(),
      });
      form.hidden = true;
      success.hidden = false;
    } catch (err) {
      alert('Er ging iets mis. Probeer het opnieuw.');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Aanmelden →';
    }
  });
    // Nieuwsbrief form
  const nieuwsbriefForm = document.getElementById('nieuwsbrief-form');
  const nieuwsbriefSuccess = document.getElementById('nieuwsbrief-success');

  if (nieuwsbriefForm) {
    nieuwsbriefForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      const submitBtn = nieuwsbriefForm.querySelector('.member-submit');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Bezig...';

      try {
        const formData = new FormData(nieuwsbriefForm);
        await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(formData).toString(),
        });
        nieuwsbriefForm.hidden = true;
        nieuwsbriefSuccess.hidden = false;
      } catch (err) {
        alert('Er ging iets mis. Probeer het opnieuw.');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Aanmelden →';
      }
    });
  }
</script>

</LayoutNight>

<style>
  .agenda-page { padding: 48px 0 96px; }

  .agenda-header { margin-bottom: 40px; }
  .eyebrow {
    font-size: 12px; font-weight: 700;
    color: var(--orange);
    text-transform: uppercase; letter-spacing: .12em;
    margin-bottom: 12px;
  }
  .agenda-header h1 {
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 700; line-height: 1.15;
    margin-bottom: 16px;
    color: var(--night-text);
  }
  .lead {
    color: var(--night-muted);
    font-size: 16px; line-height: 1.7;
    max-width: 560px;
  }

  .filters {
    display: flex; flex-wrap: wrap; gap: 8px;
    margin-bottom: 48px;
  }
  .filter-btn {
    padding: 7px 16px;
    border-radius: 999px;
    border: 1.5px solid rgba(255,255,255,.2);
    background: transparent;
    color: var(--night-muted);
    font-family: var(--font); font-size: 13px; font-weight: 700;
    cursor: pointer;
    transition: all .2s;
  }
  .filter-btn:hover { border-color: var(--orange); color: var(--orange); }
  .filter-btn.active {
    background: var(--orange-dark);
    border-color: var(--orange-dark);
    color: #fff;
  }

  /* Timeline */
  .timeline {
    position: relative;
    padding: 20px 0 40px;
    margin-bottom: 64px;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0; bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, transparent 0%, rgba(255,122,69,.4) 5%, rgba(255,122,69,.4) 95%, transparent 100%);
    transform: translateX(-50%);
  }
  .timeline-item {
    position: relative;
    width: 50%;
    padding: 0 40px 48px;
    box-sizing: border-box;
  }
  .timeline-item.left {
    left: 0;
    padding-right: 50px;
  }
  .timeline-item.right {
    left: 50%;
    padding-left: 50px;
  }
  .timeline-item.hidden { display: none; }

  .timeline-dot {
    position: absolute;
    top: 24px;
    width: 16px; height: 16px;
    background: var(--orange);
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(255,122,69,.2);
    z-index: 2;
  }
  .timeline-item.left .timeline-dot { right: -8px; }
  .timeline-item.right .timeline-dot { left: -8px; }

  /* Date naast event */
  .timeline-date {
    position: absolute;
    top: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }
  .timeline-item.left .timeline-date {
    /* Datum aan de OVERKANT van het event = rechts van timeline-line */
    left: calc(100% + 8px);
    align-items: flex-start;
    padding-left: 24px;
  }
  .timeline-item.right .timeline-date {
    /* Datum aan de OVERKANT van het event = links van timeline-line */
    right: calc(100% + 8px);
    align-items: flex-end;
    padding-right: 24px;
    text-align: right;
  }
  .td-maand {
    font-size: 13px;
    font-weight: 700;
    color: var(--orange);
    text-transform: uppercase;
    letter-spacing: .12em;
    margin-bottom: 4px;
  }
  .td-dag {
    font-size: 72px;
    font-weight: 800;
    color: rgba(255,255,255,.95);
    line-height: .9;
    letter-spacing: -.03em;
  }
  .td-dagnaam {
    font-size: 13px;
    font-weight: 700;
    color: var(--night-muted);
    text-transform: uppercase;
    letter-spacing: .12em;
    margin-top: 8px;
  }

  /* Trekken kleine "verbindingslijn" van date naar timeline */
  .timeline-date::after {
    content: '';
    position: absolute;
    top: 30px;
    height: 1px;
    background: rgba(255,122,69,.25);
    width: 20px;
  }
  .timeline-item.left .timeline-date::after { left: 0; }
  .timeline-item.right .timeline-date::after { right: 0; }

  .event-card {
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color .2s, transform .2s;
  }
  .event-card:hover {
    border-color: rgba(255,255,255,.18);
    transform: translateY(-2px);
  }

  .event-banner {
    position: relative;
    height: 160px;
    background-size: cover;
    background-position: center;
    background-color: #2a3550;
  }
  .badges-top {
    position: absolute; top: 12px; left: 12px;
    display: flex; gap: 6px; flex-wrap: wrap;
  }
  .type-badge {
    background: rgba(0,0,0,.55);
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
  }
  .type-meetup { color: #c8a8ff; }
  .type-pixels-pawns { color: #8acaff; }
  .type-try-out { color: #ffaa85; }
    .type-social { color: #ffcc66; }
  .type-geen-idee-magazine { color: #ff8ac8; }
  .type-masterclass { color: #b4e696; }
  .collab-badge {
    background: rgba(0,0,0,.55);
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 10px;
    color: #fff;
    font-weight: 600;
  }
  .prijs-badge {
    position: absolute; top: 12px; right: 12px;
    background: rgba(0,0,0,.55);
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    color: #fff;
  }

  .event-body { padding: 16px; }
  .event-body h3 {
    font-size: 16px; font-weight: 700;
    color: #fff; margin-bottom: 8px;
    line-height: 1.3;
  }
