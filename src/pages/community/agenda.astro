---

<LayoutNight
  title="Agenda"
  description="Aankomende events van de Astrolads Community in Den Haag."
  image="/images/og/community/community.jpg"
>
  <div class="agenda-page">
    <div class="section-inner">
      <Breadcrumb 
        theme="dark"
        items={[
          { name: 'Community', url: '/community' },
          { name: 'Agenda' }
        ]} 
      />

      <header class="agenda-header">
        <p class="eyebrow">Astrolads Community</p>
        <h1>Agenda</h1>
        <p class="lead">Ontdek talenten, ontmoet andere creatieve jongeren en doe mee aan onze events in de Astrolads Studio aan de Grote Markt.</p>
      </header>

      <div class="filters">
        <button class="filter-btn active" data-filter="all">Alle</button>
        <button class="filter-btn" data-filter="pixels-pawns">Pixels & Pawns</button>
        <button class="filter-btn" data-filter="try-out">Try-out Club</button>
        <button class="filter-btn" data-filter="masterclass">Masterclass</button>
        <button class="filter-btn" data-filter="meetup">Meetup</button>
      </div>

      <div class="timeline">
        {events.map((e, i) => (
          <div class:list={['timeline-item', i % 2 === 0 ? 'left' : 'right']} data-type={e.type}>
            <div class="timeline-dot" aria-hidden="true"></div>
            <div class="timeline-date" aria-hidden="true">
              <span class="td-maand">{e.maand}</span>
              <span class="td-dag">{e.dag}</span>
              <span class="td-dagnaam">{e.dagNaam}</span>
            </div>
            <article class="event-card">
              <div class="event-banner" style={`background-image: url(${e.foto});`}>
                <div class="badges-top">
                  <span class={`type-badge type-${e.type}`}>{e.typeLabel}</span>
                  {e.collab && <span class="collab-badge">i.s.m. {e.collab}</span>}
                </div>
                <div class="prijs-badge">{e.prijs}</div>
              </div>
              <div class="event-body">
                <h3>{e.titel}</h3>
                <div class="event-meta">
                  <span>🕐 {e.tijd}</span>
                  <span>📍 {e.locatie}</span>
                  {e.vol ? (
                    <span class="meta-vol">✗ Vol</span>
                  ) : (
                    <span>👥 {e.plekkenOver} plekken</span>
                  )}
                </div>
                <p class="event-beschrijving">{e.beschrijving}</p>
                                {e.vol ? (
                  e.lumaEventId ? (
                    <button class="aanmeld-btn aanmeld-btn-secondary" data-luma-modal={e.lumaEventId} data-luma-titel={e.titel}>Wachtlijst →</button>
                  ) : (
                    <a href={e.lumaUrl} target="_blank" rel="noopener" class="aanmeld-btn aanmeld-btn-secondary">Wachtlijst →</a>
                  )
                ) : (
                  e.lumaEventId ? (
                    <button class="aanmeld-btn" data-luma-modal={e.lumaEventId} data-luma-titel={e.titel}>Aanmelden →</button>
                  ) : (
                    <a href={e.lumaUrl} target="_blank" rel="noopener" class="aanmeld-btn">Aanmelden →</a>
                  )
                )}
              </div>
            </article>
          </div>
        ))}
      </div>

      <div class="member-cta">
        <div class="member-cta-text">
          <h3>Word member van de community</h3>
          <p>Maandelijkse nieuwsbrief, voorrang op aanmeldingen en korting op masterclasses.</p>
        </div>
        <form 
          class="member-form" 
          name="community-member" 
          method="POST" 
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/Bedankt/"
        >
          <input type="hidden" name="form-name" value="community-member" />
          <p class="hidden-honey"><label>Niet invullen: <input name="bot-field" /></label></p>
          
          <div class="form-row">
            <div class="form-field">
              <label for="member-voornaam">Voornaam</label>
              <input type="text" id="member-voornaam" name="voornaam" required />
            </div>
            <div class="form-field">
              <label for="member-achternaam">Achternaam</label>
              <input type="text" id="member-achternaam" name="achternaam" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-field">
              <label for="member-leeftijd">Leeftijd</label>
              <input type="number" id="member-leeftijd" name="leeftijd" min="14" max="99" required />
            </div>
            <div class="form-field">
              <label for="member-telefoon">Telefoonnummer</label>
              <input type="tel" id="member-telefoon" name="telefoon" required />
            </div>
          </div>

          <div class="form-field">
            <label for="member-email">E-mailadres</label>
            <input type="email" id="member-email" name="email" required />
          </div>

          <button type="submit" class="member-submit">Word member →</button>
        </form>
      </div>

    </div>
  </div>
<!-- Luma modal -->
<div id="luma-modal" class="luma-modal" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="luma-modal-backdrop" data-luma-close></div>
  <div class="luma-modal-content">
    <div class="luma-modal-header">
      <span class="luma-modal-titel" id="luma-modal-titel"></span>
      <button class="luma-modal-close" data-luma-close aria-label="Sluiten">×</button>
    </div>
    <iframe id="luma-iframe" src="" width="100%" height="600" frameborder="0" allow="payment" title="Aanmelden voor evenement"></iframe>
  </div>
</div>

<script>
  const modal = document.getElementById('luma-modal');
  const iframe = document.getElementById('luma-iframe');
  const titelEl = document.getElementById('luma-modal-titel');

  document.querySelectorAll('[data-luma-modal]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const eventId = btn.getAttribute('data-luma-modal');
      const titel = btn.getAttribute('data-luma-titel');
      iframe.src = 'https://luma.com/embed/event/' + eventId + '/simple';
      titelEl.textContent = titel;
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    });
  });

  document.querySelectorAll('[data-luma-close]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      iframe.src = '';
      document.body.style.overflow = '';
    });
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal.classList.contains('open')) {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      iframe.src = '';
      document.body.style.overflow = '';
    }
  });
</script>

</LayoutNight>

<style>
  .agenda-page { padding: 48px 0 96px; }

  .agenda-header { margin-bottom: 40px; }
  .eyebrow {
    font-size: 12px; font-weight: 700;
    color: var(--orange);
    text-transform: uppercase; letter-spacing: .12em;
    margin-bottom: 12px;
  }
  .agenda-header h1 {
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 700; line-height: 1.15;
    margin-bottom: 16px;
    color: var(--night-text);
  }
  .lead {
    color: var(--night-muted);
    font-size: 16px; line-height: 1.7;
    max-width: 560px;
  }

  .filters {
    display: flex; flex-wrap: wrap; gap: 8px;
    margin-bottom: 48px;
  }
  .filter-btn {
    padding: 7px 16px;
    border-radius: 999px;
    border: 1.5px solid rgba(255,255,255,.2);
    background: transparent;
    color: var(--night-muted);
    font-family: var(--font); font-size: 13px; font-weight: 700;
    cursor: pointer;
    transition: all .2s;
  }
  .filter-btn:hover { border-color: var(--orange); color: var(--orange); }
  .filter-btn.active {
    background: var(--orange-dark);
    border-color: var(--orange-dark);
    color: #fff;
  }

  /* Timeline */
  .timeline {
    position: relative;
    padding: 20px 0 40px;
    margin-bottom: 64px;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0; bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, transparent 0%, rgba(255,122,69,.4) 5%, rgba(255,122,69,.4) 95%, transparent 100%);
    transform: translateX(-50%);
  }
  .timeline-item {
    position: relative;
    width: 50%;
    padding: 0 40px 48px;
    box-sizing: border-box;
  }
  .timeline-item.left {
    left: 0;
    padding-right: 50px;
  }
  .timeline-item.right {
    left: 50%;
    padding-left: 50px;
  }
  .timeline-item.hidden { display: none; }

  .timeline-dot {
    position: absolute;
    top: 24px;
    width: 16px; height: 16px;
    background: var(--orange);
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(255,122,69,.2);
    z-index: 2;
  }
  .timeline-item.left .timeline-dot { right: -8px; }
  .timeline-item.right .timeline-dot { left: -8px; }

  /* Date naast event */
  .timeline-date {
    position: absolute;
    top: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }
  .timeline-item.left .timeline-date {
    /* Datum aan de OVERKANT van het event = rechts van timeline-line */
    left: calc(100% + 8px);
    align-items: flex-start;
    padding-left: 24px;
  }
  .timeline-item.right .timeline-date {
    /* Datum aan de OVERKANT van het event = links van timeline-line */
    right: calc(100% + 8px);
    align-items: flex-end;
    padding-right: 24px;
    text-align: right;
  }
  .td-maand {
    font-size: 13px;
    font-weight: 700;
    color: var(--orange);
    text-transform: uppercase;
    letter-spacing: .12em;
    margin-bottom: 4px;
  }
  .td-dag {
    font-size: 72px;
    font-weight: 800;
    color: rgba(255,255,255,.95);
    line-height: .9;
    letter-spacing: -.03em;
  }
  .td-dagnaam {
    font-size: 13px;
    font-weight: 700;
    color: var(--night-muted);
    text-transform: uppercase;
    letter-spacing: .12em;
    margin-top: 8px;
  }

  /* Trekken kleine "verbindingslijn" van date naar timeline */
  .timeline-date::after {
    content: '';
    position: absolute;
    top: 30px;
    height: 1px;
    background: rgba(255,122,69,.25);
    width: 20px;
  }
  .timeline-item.left .timeline-date::after { left: 0; }
  .timeline-item.right .timeline-date::after { right: 0; }

  .event-card {
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color .2s, transform .2s;
  }
  .event-card:hover {
    border-color: rgba(255,255,255,.18);
    transform: translateY(-2px);
  }

  .event-banner {
    position: relative;
    height: 160px;
    background-size: cover;
    background-position: center;
    background-color: #2a3550;
  }
  .badges-top {
    position: absolute; top: 12px; left: 12px;
    display: flex; gap: 6px; flex-wrap: wrap;
  }
  .type-badge {
    background: rgba(0,0,0,.55);
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
  }
  .type-meetup { color: #c8a8ff; }
  .type-pixels-pawns { color: #8acaff; }
  .type-try-out { color: #ffaa85; }
    .type-social { color: #ffcc66; }
  .type-geen-idee-magazine { color: #ff8ac8; }
  .type-masterclass { color: #b4e696; }
  .collab-badge {
    background: rgba(0,0,0,.55);
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 10px;
    color: #fff;
    font-weight: 600;
  }
  .prijs-badge {
    position: absolute; top: 12px; right: 12px;
    background: rgba(0,0,0,.55);
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    color: #fff;
  }

  .event-body { padding: 16px; }
  .event-body h3 {
    font-size: 16px; font-weight: 700;
    color: #fff; margin-bottom: 8px;
    line-height: 1.3;
  }
  .event-meta {
    display: flex; flex-wrap: wrap;
    gap: 10px;
    font-size: 11px;
    color: var(--night-muted);
    margin-bottom: 10px;
  }
  .meta-vol { color: #ff8888; font-weight: 700; }
  .event-beschrijving {
    font-size: 13px;
    color: rgba(255,255,255,.7);
    line-height: 1.55;
    margin-bottom: 14px;
  }
  .aanmeld-btn {
    display: inline-block;
    background: var(--orange);
    color: #fff;
    padding: 7px 16px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 12px; font-weight: 700;
    transition: background .2s;
  }
  .aanmeld-btn:hover { background: var(--orange-dark); }
  .aanmeld-btn-secondary {
    background: transparent;
    border: 1px solid rgba(255,255,255,.3);
    color: rgba(255,255,255,.7);
  }
  .aanmeld-btn-secondary:hover {
    background: rgba(255,255,255,.06);
    color: #fff;
  }
    /* Luma modal */
  .luma-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .luma-modal.open { display: flex; }
  .luma-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,.7);
    backdrop-filter: blur(4px);
  }
  .luma-modal-content {
    position: relative;
    background: #fff;
    border-radius: var(--radius);
    width: 100%;
    max-width: 480px;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0,0,0,.4);
  }
  .luma-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    border-bottom: 1px solid rgba(0,0,0,.08);
  }
  .luma-modal-titel {
    font-weight: 700;
    color: var(--text);
    font-size: 15px;
  }
  .luma-modal-close {
    background: none;
    border: none;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    color: var(--muted);
    padding: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background .2s;
  }
  .luma-modal-close:hover {
    background: var(--bg);
    color: var(--text);
  }
  #luma-iframe {
    flex: 1;
    border: none;
    min-height: 600px;
  }
  @media (max-width: 768px) {
    .luma-modal { padding: 12px; }
    .luma-modal-content { max-height: 95vh; }
    #luma-iframe { min-height: 500px; }
  }

  .member-cta {
    background: rgba(255,122,69,.08);
    border: 1px solid rgba(255,122,69,.25);
    border-radius: var(--radius);
    padding: 32px;
  }
  .member-cta-text {
    text-align: center;
    margin-bottom: 24px;
  }
  .member-cta h3 {
    font-size: 22px; font-weight: 700;
    color: #fff; margin-bottom: 8px;
  }
  .member-cta p {
    font-size: 14px;
    color: var(--night-muted);
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }

  .member-form {
    max-width: 560px;
